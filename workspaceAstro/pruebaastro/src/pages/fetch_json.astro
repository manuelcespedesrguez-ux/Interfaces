---
import tecnologias from "../content/tecnologia.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <h1>Listado de todas las tecnologias que domino</h1>
  <ul>
    {
      tecnologias.map((tecnologia) => (
        <li>
          {tecnologia.nombre} - <em>{tecnologia.nivel}</em>
        </li>
      ))
    }
  </ul>
</BaseLayout>