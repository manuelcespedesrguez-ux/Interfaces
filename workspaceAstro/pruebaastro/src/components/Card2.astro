---
const title = Astro.props.title
const img = Astro.props.img
---


<div class="card">

    <img src={img} alt={title} class="card-img"/>
    <div class="card-body">
        <h3>{title}</h3>
    </div>
</div>

<style>
    .card {
        width: 200px;
        background-color: rgb(0, 177, 0);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
    }

    .card-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    .card-body {
        padding: 12px;
        text-align: center;
    }

    .card-body h3 {
        margin: 0;
        font-size: 1rem;
        color: #333;
    }
</style>